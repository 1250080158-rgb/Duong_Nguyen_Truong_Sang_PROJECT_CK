# Biến môi trường cho docker compose.
# Sao chép thành .env rồi sửa theo nhu cầu; docker compose tự đọc file này.

# ---- Cổng công khai trên máy chủ ----
WEB_PORT=3000
API_PORT=8081
KEYCLOAK_PORT=8080
POSTGRES_PORT=5432

# ---- Chế độ xác thực ----
# Oidc : dùng Keycloak (bản thật). Đăng nhập qua trình duyệt.
# Dev  : API tự cấp JWT, dùng mật khẩu chung "123456" tại màn /login,
#        không cần đăng nhập qua Keycloak (tiện khi phát triển nhanh).
AUTH_MODE=Oidc

# Frontend đọc biến VITE_OIDC_ENABLED lúc build ảnh Docker. Phải là
# chuỗi "true"/"false" và giữ khớp với AUTH_MODE ở trên.
# Tên biến cố tình KHÔNG bắt đầu bằng "VITE_": file .env này do
# docker compose đọc, nếu đặt trùng tên Vite sẽ lấy nhầm khi chạy
# `npm run dev`. docker-compose.yml ánh xạ sang build arg cho đúng.
OIDC_UI_ENABLED=true

# ---- Thông tin quản trị Keycloak (dùng vào lần đầu đăng nhập quản trị) ----
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=123456

# ---- Mật khẩu CSDL ----
# Đây là bản chạy thử; đổi trước khi triển khai thật.
POSTGRES_PASSWORD=123456
