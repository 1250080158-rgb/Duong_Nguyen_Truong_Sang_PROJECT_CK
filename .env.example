# Cấu hình môi trường cho Vite.
# Sao chép file này thành .env.local rồi sửa theo môi trường chạy thật.

# ---- Địa chỉ API ASP.NET Core ----
VITE_API_BASE=http://localhost:5000/api

# ---- OpenID Connect / Keycloak ----
# Bật lên (true) để dùng luồng Authorization Code + PKCE qua Keycloak.
# Đặt false thì quay về đăng nhập dev bằng mật khẩu tại /login.
VITE_OIDC_ENABLED=false

# Realm và client của Keycloak (xem docker/keycloak/realm-medequip.json)
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/medequip
VITE_OIDC_CLIENT_ID=medequip-ui
VITE_OIDC_SCOPE=openid profile email

# Để trống thì tự suy ra từ địa chỉ đang truy cập.
# Khi chạy trong Docker ở cổng khác, ghi rõ ở đây:
# VITE_OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
# VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/login
